# cli-guard (`cg`) configuration
# Layer 0 (cache, OSV/OpenSSF advisories, release cooldown) and Layer 1 (AST + version diff + shims)
# work completely WITHOUT any API key.

# Default provider: Meta Model API (https://dev.meta.ai -> https://api.meta.ai/v1)
CG_LLM_PROVIDER=meta
MODEL_API_KEY=
CG_TRIAGE_MODEL=muse-spark-1.3
CG_INVESTIGATOR_MODEL=muse-spark-1.3

# To switch providers, change CG_LLM_PROVIDER to one of:
#   meta | ollama | llamacpp | openrouter | groq | together | openai | anthropic | gemini | custom | static
#
# Open-source / local examples (no paid API required):
#   CG_LLM_PROVIDER=ollama
#   CG_TRIAGE_MODEL=qwen2.5-coder:7b
#   CG_INVESTIGATOR_MODEL=qwen2.5-coder:32b
#
#   CG_LLM_PROVIDER=llamacpp
#   CG_LLM_BASE_URL=http://localhost:8080/v1
#
#   CG_LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   CG_TRIAGE_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
#
#   CG_LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
#   CG_TRIAGE_MODEL=llama-3.3-70b-versatile
#
#   CG_LLM_PROVIDER=static   # Layer 0 + Layer 1 AST/diff only (0 LLM calls)

# Guard policy
CG_COOLDOWN_HOURS=24
CG_FAIL_OPEN=false
CG_MAX_INVESTIGATOR_TURNS=8

# Live monitor & Bitcoin OpenTimestamps auto-upgrade
CG_OTS_UPGRADE_INTERVAL=1800

# GitHub automation (optional): push public salted commitments to `cli-guard-ledger`
# and/or open Pull Requests to OpenSSF `malicious-packages` when malware is detected.
GITHUB_TOKEN=
CG_LEDGER_REPO=
CG_AUTO_PUSH_LEDGER=false
CG_OPENSSF_REPO=ossf/malicious-packages
CG_OPENSSF_FORK=
CG_AUTO_OPENSSF_PR=false

# Option A hosted CLI Runner backend URL (optional, embedded into `docs/snapshot.json` on export)
CG_PUBLIC_API_URL=
